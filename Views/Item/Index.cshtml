
@model IEnumerable<FindBack.Models.Item>

@using System.Security.Claims

@{
    ViewData["Title"] = "All Items";

    var currentUserId = User.FindFirstValue(
        ClaimTypes.NameIdentifier
    );
}

<div class="container mt-5">

    <!-- Page Header -->

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2>Lost & Found Items</h2>
            <p class="text-muted">
                Browse and search reported items
            </p>
        </div>

        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-action="Create"
               class="btn btn-success">
                + Report Item
            </a>
        }
        else
        {
            <a asp-area="Identity"
               asp-page="/Account/Login"
               class="btn btn-success">
                Login to Report Item
            </a>
        }

    </div>


    <!-- Search and Filter Form -->

    <form asp-controller="Item"
          asp-action="Index"
          method="get"
          class="card p-3 mb-4 shadow-sm">

        <div class="row">

            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Item Name
                </label>

                <input type="text"
                       name="searchString"
                       value="@Context.Request.Query["searchString"]"
                       class="form-control"
                       placeholder="Search item..." />

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Type
                </label>

                <select name="type" class="form-select">

                    <option value="">All Types</option>

                    <option value="Lost"
                            selected="@(Context.Request.Query["type"] == "Lost")">
                        Lost
                    </option>

                    <option value="Found"
                            selected="@(Context.Request.Query["type"] == "Found")">
                        Found
                    </option>

                </select>

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Category
                </label>

                <input type="text"
                       name="category"
                       value="@Context.Request.Query["category"]"
                       class="form-control"
                       placeholder="Electronics..." />

            </div>


            <div class="col-md-3 mb-3">

                <label class="form-label">
                    Location
                </label>

                <input type="text"
                       name="location"
                       value="@Context.Request.Query["location"]"
                       class="form-control"
                       placeholder="Enter location..." />

            </div>

        </div>


        <div>

            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Reset
            </a>

        </div>

    </form>


    <!-- Items List -->

    <div class="row">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <!-- Item Image -->

                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@item.Title" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:200px;">

                                <span class="text-muted">
                                    No Image Available
                                </span>

                            </div>
                        }


                        <!-- Card Body -->

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @item.Title
                            </h5>


                            <p class="card-text text-muted">
                                @item.Description
                            </p>


                            <p class="mb-2">
                                <strong>Category:</strong>
                                @item.Category
                            </p>


                            <p class="mb-2">
                                <strong>Location:</strong>
                                @item.Location
                            </p>


                            <p class="mb-3">
                                <strong>Date:</strong>
                                @item.Date.ToShortDateString()
                            </p>


                            <!-- Lost / Found Status -->

                            <div class="mb-2">

                                @if (item.Type == "Lost")
                                {
                                    <span class="badge bg-danger">
                                        Lost
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Found
                                    </span>
                                }


                                <!-- Returned Status -->

                                @if (item.IsReturned)
                                {
                                    <span class="badge bg-secondary">
                                        Returned
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        Not Returned
                                    </span>
                                }

                            </div>


                            <hr />


                            <!-- Action Buttons -->

                            <div class="d-flex gap-2 flex-wrap mt-auto">

                                <!-- Everyone Can View Details -->

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>


                                <!-- Only Owner Can Edit/Delete -->

                                @if (!string.IsNullOrEmpty(currentUserId)
                                     && item.UserId == currentUserId)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="alert alert-info text-center">

                    <h5>No Matching Items Found</h5>

                    <p class="mb-0">
                        Try changing your search or filter criteria.
                    </p>

                </div>

            </div>
        }

    </div>

</div>
