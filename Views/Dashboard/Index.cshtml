
@model IEnumerable<FindBack.Models.Item>

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container mt-5">

    <!-- Dashboard Header -->
    <div class="mb-4">
        <h2>My Dashboard</h2>

        <p class="text-muted">
            Welcome, @User.Identity?.Name!
            Manage your reported lost and found items here.
        </p>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-primary h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total Reports</h6>
                    <h2 class="text-primary">
                        @ViewBag.TotalItems
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-danger h-100">
                <div class="card-body">
                    <h6 class="text-muted">Lost Items</h6>
                    <h2 class="text-danger">
                        @ViewBag.LostItems
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-success h-100">
                <div class="card-body">
                    <h6 class="text-muted">Found Items</h6>
                    <h2 class="text-success">
                        @ViewBag.FoundItems
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-secondary h-100">
                <div class="card-body">
                    <h6 class="text-muted">Returned Items</h6>
                    <h2 class="text-secondary">
                        @ViewBag.ReturnedItems
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- My Items Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h4>My Reported Items</h4>

        <a asp-controller="Item"
           asp-action="Create"
           class="btn btn-success">
            + Report New Item
        </a>

    </div>

    <div class="row">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">

                    <div class="card shadow-sm h-100">

                        <!-- Item Image -->
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl"
                                 class="card-img-top"
                                 style="height:200px; object-fit:cover;"
                                 alt="@item.Title" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:200px;">

                                <span class="text-muted">
                                    No Image Available
                                </span>

                            </div>
                        }

                        <div class="card-body d-flex flex-column">

                            <h5 class="card-title">
                                @item.Title
                            </h5>

                            <p>
                                <strong>Category:</strong>
                                @item.Category
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @item.Location
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.Date.ToShortDateString()
                            </p>

                            <!-- Lost / Found Status -->
                            @if (item.Type == "Lost")
                            {
                                <span class="badge bg-danger mb-2">
                                    Lost
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success mb-2">
                                    Found
                                </span>
                            }

                            <!-- Returned Status -->
                            @if (item.IsReturned)
                            {
                                <span class="badge bg-secondary mb-2">
                                    Returned
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark mb-2">
                                    Not Returned
                                </span>
                            }

                            <hr />

                            <!-- Action Buttons -->
                            <div class="d-flex gap-2 flex-wrap mt-auto">

                                <a asp-controller="Item"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                <a asp-controller="Item"
                                   asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-controller="Item"
                                   asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </div>

                            <!-- Mark as Returned -->
                            @if (!item.IsReturned)
                            {
                                <form asp-controller="Item"
                                      asp-action="MarkReturned"
                                      method="post"
                                      class="mt-3">

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    <button type="submit"
                                            class="btn btn-success btn-sm w-100"
                                            onclick="return confirm('Are you sure this item has been returned?');">
                                        Mark as Returned
                                    </button>

                                </form>
                            }

                        </div>

                    </div>

                </div>
            }
        }
        else
        {
            <div class="col-12">

                <div class="alert alert-info text-center">

                    <h5>You haven't reported any items yet.</h5>

                    <p>
                        Start by reporting a lost or found item.
                    </p>

                    <a asp-controller="Item"
                       asp-action="Create"
                       class="btn btn-primary">
                        Report Your First Item
                    </a>

                </div>

            </div>
        }

    </div>

</div>
